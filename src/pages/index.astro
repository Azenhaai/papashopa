---
import BaseLayout from '../layouts/BaseLayout.astro';
import products from '../data/products.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [...new Set(products.map((p) => p.category))];
---
<BaseLayout active="shop">
  <section class="hero">
    <div class="wrap">
      <h1>Everything a papa actually wants 🔥</h1>
      <p>Grill gear, serious coffee, cozy flannel and workshop toys. A demo store — browse, fill the cart, walk the checkout, earn points.</p>
    </div>
  </section>
  <main>
    <div class="wrap">
      <div class="chips" id="chips">
        <button class="chip on" data-cat="all">All</button>
        {categories.map((c) => <button class="chip" data-cat={c}>{c}</button>)}
      </div>
      <div class="grid" id="grid">
        {products.map((p) => (
          <div class="card" data-cat={p.category}>
            {p.badge && <span class={`badge ${p.badge}`}>{p.badge}</span>}
            <a class="pic" href={`${base}/product/${p.slug}`}>{p.emoji}</a>
            <h3><a href={`${base}/product/${p.slug}`}>{p.name}</a></h3>
            <span class="cat">{p.category}</span>
            <div class="row">
              <span class="price">
                {p.oldPrice && <span class="old">€{p.oldPrice.toFixed(2)}</span>}
                €{p.price.toFixed(2)}
              </span>
              <button class="btn small" data-add={p.slug}>+ Cart</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  document.getElementById('chips').addEventListener('click', function (e) {
    var chip = e.target.closest('.chip');
    if (!chip) return;
    document.querySelectorAll('.chip').forEach(function (c) { c.classList.remove('on'); });
    chip.classList.add('on');
    var cat = chip.dataset.cat;
    document.querySelectorAll('#grid .card').forEach(function (card) {
      card.style.display = cat === 'all' || card.dataset.cat === cat ? '' : 'none';
    });
  });

  document.getElementById('grid').addEventListener('click', function (e) {
    var btn = e.target.closest('[data-add]');
    if (!btn) return;
    PS.addToCart(btn.dataset.add, 1);
    var item = PS.gaItem(btn.dataset.add, 1);
    if (item) PS.track('add_to_cart', { currency: 'EUR', value: item.price, items: [item] });
    btn.textContent = '✓ Added';
    setTimeout(function () { btn.textContent = '+ Cart'; }, 900);
  });

  PS.track('view_item_list', { item_list_name: 'Storefront' });
</script>
